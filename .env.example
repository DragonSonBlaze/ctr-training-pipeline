# Copy to .env (make env) and change the passwords. .env is not committed.

# Postgres: one server holding the mlflow and monitoring databases
POSTGRES_USER=ctr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ctr
POSTGRES_PORT=5432

# Read-only login that Grafana uses on the monitoring database
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=change-me-too

# Grafana web login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-three
GRAFANA_PORT=3000

# MLflow tracking server. Host port 5001 because macOS AirPlay Receiver holds 5000.
# MLFLOW_VERSION must match the mlflow pin in pyproject.toml.
MLFLOW_VERSION=3.18.0
MLFLOW_PORT=5001

# Read by code running on the Mac
MLFLOW_TRACKING_URI=http://localhost:5001
SPARK_DRIVER_MEMORY=6g
