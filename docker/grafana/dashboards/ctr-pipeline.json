      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT DISTINCT ON (data_date, step) data_date::timestamptz AS time, step AS metric, duration_s AS value FROM pipeline_step_runs WHERE status = 'success' AND data_date IS NOT NULL AND $__timeFilter(data_date) ORDER BY data_date, step, finished_at DESC"
        }
      ]
    },
