            "uid": "monitoring-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT time, metric, value FROM (SELECT DISTINCT ON (data_date, model_type) data_date::timestamptz AS time, model_type AS metric, mean_pred AS value FROM model_runs WHERE $__timeFilter(data_date) ORDER BY data_date, model_type, recorded_at DESC) predicted UNION ALL SELECT DISTINCT ON (data_date) data_date::timestamptz, 'actual', actual_ctr FROM model_runs WHERE $__timeFilter(data_date) ORDER BY 1, 2"
        }
      ]
