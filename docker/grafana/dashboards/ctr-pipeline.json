          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT data_date::timestamptz AS time, observed AS rows FROM data_quality_results WHERE check_name = 'min_rows_per_day' AND $__timeFilter(data_date) ORDER BY 1"
